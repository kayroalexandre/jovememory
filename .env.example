# Only synthetic examples. Use npm run local:init to generate private local credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3007
PUBLIC_URL=http://127.0.0.1:3007
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Optional Railway bootstrap: generated 64-hex password, independent of the database owner.
# Set when deriving the runtime URL; local setup already generates DATABASE_URL.
APP_DATABASE_PASSWORD=
# JSON array of {id,sha256,role,workspaces}; hashes only, never plaintext tokens.
AUTH_PROFILES=[]
# Additional scoped client profiles; same strict schema, existing base profiles preserved.
EXTRA_AUTH_PROFILES=[]
# Independent trusted controller/metrics profiles, merged without replacing project profiles.
CONTROL_AUTH_PROFILES=[]
MEMORY_REVIEW_MODE=automatic
# Generated 256-bit hex key in a private Railway variable; local secret file stays outside checkout.
PROJECT_TOKEN_SECRET=
PROJECT_TOKEN_SECRET_FILE=
# explicit by default; Railway can derive a separate signing key from its private DB credential.
PROJECT_TOKEN_KEY_MODE=explicit
# Explicit profile used by the local stdio process (must exist in AUTH_PROFILES).
STDIO_PROFILE=
# OpenRouter model routing. No external calls unless ENABLE_PROVIDER=true.
ENABLE_PROVIDER=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_API_KEY=
# Local-only alternative: absolute path to a chmod-600 file outside the repository.
PROVIDER_API_KEY_FILE=
# Byte budget for candidate text sent to rerank/synthesis. Returned evidence stays complete.
RERANK_PAYLOAD_BYTES=1048576
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
DECISION_MODEL=upstage/solar-decide
RERANK_MODEL=qwen/qwen3.8-flash
KNOWLEDGE_MODEL=deepseek/deepseek-v4-flash
SYNTHESIS_MODEL=openrouter/free
# Ordered free preferences are filtered against the live catalog and zero-price endpoints.
FREE_INFERENCE_PREFERENCES=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
INFERENCE_FALLBACK_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,xiaomi/mimo-v2.5
# Paid inference fallbacks have no price ceiling; provider routing still prefers price.
WRITE_THRESHOLD=0.60
CROSS_WORKSPACE_THRESHOLD=0.75
# Compose-only: owner password for the development PostgreSQL service. npm run local:init writes it.
LOCAL_DATABASE_PASSWORD=
# Scratch database URL for `npm run backup:verify`; must name jovememory_restore_* and be empty.
RESTORE_DATABASE_URL=
# Private S3 bucket: Railway reference variables in production, local SeaweedFS in development.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
