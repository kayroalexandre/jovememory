# Only synthetic examples. Use npm run local:init to generate private local credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3007
PUBLIC_URL=http://127.0.0.1:3007
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Optional Railway bootstrap: generated 64-hex password, independent of the database owner.
# Set when deriving the runtime URL; local setup already generates DATABASE_URL.
APP_DATABASE_PASSWORD=
# JSON array of {id,sha256,role,workspaces}; hashes only, never plaintext tokens.
AUTH_PROFILES=[]
# Additional scoped client profiles; same strict schema, existing base profiles preserved.
EXTRA_AUTH_PROFILES=[]
MEMORY_REVIEW_MODE=automatic
# Explicit profile used by the local stdio process (must exist in AUTH_PROFILES).
STDIO_PROFILE=
# OpenRouter model routing. No external calls unless ENABLE_PROVIDER=true.
ENABLE_PROVIDER=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_API_KEY=
# Local-only alternative: absolute path to a chmod-600 file outside the repository.
PROVIDER_API_KEY_FILE=
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
DECISION_MODEL=upstage/solar-decide
RERANK_MODEL=qwen/qwen3.8-flash
KNOWLEDGE_MODEL=deepseek/deepseek-v4-flash
SYNTHESIS_MODEL=stealth/space-bunny-alpha
WRITE_THRESHOLD=0.60
CROSS_WORKSPACE_THRESHOLD=0.75
# Private S3 bucket: Railway reference variables in production, local SeaweedFS in development.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
